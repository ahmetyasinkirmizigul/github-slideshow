@startuml
title Parametreler (Input / Output / Run-time)

class InputParameters <<Init listesi, init()'ten önce okunur>> {
  + max_Speed : double_t [knot]
  + max_Altitude : double_t [ft]
  + Position : LLA [derece, derece, m]
  + Rotation : HPR [derece]
  + Speed : double_t [m/s]
  + RCS : double_t [m²]
  + EO_Reflectance : double_t [-]
  + IR_DeltaTemperature : double_t [K]
}

class InputEvents <<EventType>> {
  + GO_DIRECTION : Azimuth, Speed, AltitudeMSL
  + FOLLOW_PATH : Speed, WaypointName[Latitude, Longitude, AltitudeMSL], RepeatPath
  + STOP : StopMode {ORBIT, LAZY, FREEZE}
  + REMOVE
}

class FixedConstants <<sabit, konfigürasyondan okunmaz>> {
  + kRebaseDistance_m : double_t [m] = 5000.0
  + LOS_LOOKAHEAD : double_t [m] = 5000.0
  + LOS_SAFETY_MARGIN : double_t [m] = 100.0
  + LOS_RECHECK_DISTANCE : double_t [m] = 4900.0
  + min_Speed_knot : double_t [knot] = 100.0
  + orbit_radius_m_ : double_t [m] = 5000.0
  + orbit_speed_mps_ : double_t [m/s] = 150.0
  + goDirClimbAngle_deg_ : double_t [derece] = 10.0
}

class RuntimeParameters <<Scheduler / ECS>> {
  + agentPeriod : double_t [s]
  + priority : uint32_t [-]
  + simTime : double_t [s]
  + deltaT : double_t [s]
  + isActive : bool
  + internalState_ : InternalState {Init, GoToPoint, GoDirection, FollowPath, Stop}
  + stopMode_ : StopMode {ORBIT, LAZY, FREEZE}
  + maxSpeed_mps : double_t [m/s]
  + maxAlt_m : double_t [m]
  + targetLLA : glm::dvec3 [derece, derece, m]
  + targetSpeedmps : double_t [m/s]
  + targetAzimuth : double_t [derece]
  + go_dir_altitude_ : double_t [m]
  + waypoints_ : std::vector<glm::dvec3>
  + waypointIndex_ : size_t
  + pathSpeedMPS_ : double_t [m/s]
  + pathRepeat : bool
  + isPathObstructed : bool
  + obstructionDistanceM : double_t [m]
  + obstructionCheckDistance : double_t [m]
  + orbit_center_lla_ : glm::dvec3 [derece, derece, m]
  + orbit_angle_rad_ : double_t [rad]
  + refLLA : glm::dvec3 [derece, derece, m]
}

class Outputs <<Log / Durum>> {
  + PositionLog : konum, yönelim, hız
  + state_out_ : lla, ecef, ned, hpr, linearVelocity, speed
}

InputParameters --> RuntimeParameters : yapılandırma\n(m/s ve m'ye çevrilir)
InputEvents ..> RuntimeParameters : internalState_ günceller,\nhedef / yön / waypoint atar
RuntimeParameters --> Outputs : üretir

@enduml
